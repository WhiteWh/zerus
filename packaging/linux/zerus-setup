#!/usr/bin/env python3
"""Create per-user compatibility links or register the desktop service.

Existing SSH protocols use ~/.local/bin/hgs. Pacman cannot install into a user's
home, so the default command supplies that link without replacing existing
executables or starting services. --desktop-service explicitly registers this
user's background service with the selected CLI and local configuration.
"""
import argparse
import os
from pathlib import Path
import subprocess
import sys

CONNECTOR_ACTIONS = ("install", "protect", "migrate", "rollback")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prefix", type=Path, default=Path("/usr"),
                        help="system installation prefix (default: /usr)")
    parser.add_argument("--mobile-connector", choices=CONNECTOR_ACTIONS,
                        help="install, protect, migrate or roll back the mobile connector's user service; "
                             "writes one file and starts or restarts nothing")
    parser.add_argument("--binary", help="with --mobile-connector install or migrate: the Rust connector to use "
                                         "when both /usr/bin and ~/.local/bin copies exist")
    parser.add_argument("--desktop-service", nargs="?", const="install", choices=("install", "session"),
                        help="register the user desktop service, or refresh its current graphical session")
    parser.add_argument("--hgs", type=Path, help="with --desktop-service: the selected local CLI")
    parser.add_argument("--config-dir", help="with --desktop-service: selected HGS_CONFIG_DIR")
    parser.add_argument("--state-dir", help="with --desktop-service: selected HGS_STATE_DIR")
    parser.add_argument("--no-start", action="store_true", help="register desktop startup for the next graphical login")
    parser.add_argument("--check", action="store_true", help="validate desktop registration without changing files")
    args = parser.parse_args()
    if os.geteuid() == 0:
        parser.error("run this command as the desktop user, without sudo")
    if args.binary and args.mobile_connector not in ("install", "migrate"):
        parser.error("--binary applies to --mobile-connector install and migrate")
    if args.desktop_service and args.mobile_connector:
        parser.error("choose desktop or mobile connector registration separately")
    if not args.desktop_service and (args.hgs or args.config_dir or args.state_dir or args.no_start or args.check):
        parser.error("desktop options require --desktop-service")
    if args.desktop_service:
        tool = args.prefix.resolve() / "lib/zerus/install-linux-desktop-service.py"
        if not tool.is_file():
            parser.error(f"packaged file is missing: {tool}")
        hgs = args.hgs if args.hgs is not None else args.prefix.resolve() / "bin/hgs"
        command = [sys.executable, str(tool), args.desktop_service, "--hgs", str(hgs)]
        for flag, value in (("--config-dir", args.config_dir), ("--state-dir", args.state_dir)):
            if value is not None:
                command += [flag, value]
        if args.no_start:
            command.append("--no-start")
        if args.check:
            command.append("--check")
        return subprocess.run(command, stdin=subprocess.DEVNULL, close_fds=True).returncode
    if args.mobile_connector:
        # Only the connector service changes; no compatibility link is made.
        tool = args.prefix.resolve() / "lib/zerus/install-mobile-connector-service.py"
        if not tool.is_file():
            parser.error(f"packaged file is missing: {tool}")
        command = [sys.executable, str(tool), args.mobile_connector]
        if args.binary:
            command += ["--binary", args.binary]
        return subprocess.run(command, stdin=subprocess.DEVNULL).returncode
    directory = Path.home() / ".local/bin"
    # Check every conflict before making any change. An existing source install
    # may own these stable paths; migration is an explicit user decision.
    links = [(directory / name, args.prefix.resolve() / "bin" / name)
             for name in ("hgs", "hgs-tray", "hgs_state.py")]
    for destination, target in links:
        if not target.is_file():
            parser.error(f"packaged file is missing: {target}")
        if os.path.lexists(destination) and destination.resolve() != target:
            parser.error(f"existing file kept: {destination}. Move it aside deliberately before migrating.")
    directory.mkdir(parents=True, exist_ok=True)
    for destination, target in links:
        if not os.path.lexists(destination):
            destination.symlink_to(target)
    print("Compatibility links ready. Existing agent sessions and services were left running.")
    print("Optional desktop autostart: systemctl --user enable --now hgs-tray.service")
    print("Desktop background service: zerus-setup --desktop-service")
    print("Optional background workers: systemctl --user enable --now hgs-swarm.service hgs-recovery.service")
    return 0


if __name__ == "__main__":
    sys.exit(main())
